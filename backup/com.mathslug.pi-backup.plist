<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily pull of the Pi's application state onto this Mac.

  Install:
    cp backup/com.mathslug.pi-backup.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.mathslug.pi-backup.plist
    sudo pmset repeat wakeorpoweron MTWRFSU 05:58:00

  Run once now:
    launchctl kickstart -k gui/$UID/com.mathslug.pi-backup

  The pmset line is not optional on a laptop. Left alone, launchd starts the
  job during one of the brief background wakes a sleeping Mac takes anyway,
  and it sleeps again seconds later with the transfer half done. On battery
  the power assertion pull-backups.sh takes does not prevent that: on
  2026-08-12 the assertion was held and the machine slept six seconds later
  regardless. A scheduled wake two minutes early gives the job a real one.

  RunAtLoad is deliberately off, so logging in repeatedly doesn't pile up
  snapshots.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mathslug.pi-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/johnbentley/src/rpi/backup/pull-backups.sh</string>
    </array>

    <!--
      06:00, chosen against two constraints rather than picked round.

      Late enough: karb's daily scan fires at 04:00 local and has taken ~30
      minutes; on a day with new pairs to screen it will take considerably
      longer. Backing up mid-scan is not unsafe — VACUUM INTO is consistent by
      construction — but it makes both slower for no reason.

      Early enough: a laptop is far more likely to be at home and on the LAN at
      dawn than at 12:30, which was the previous setting and close to the worst
      possible slot for a machine that leaves the house.
    -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>6</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/johnbentley/src/rpi/backups/backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/johnbentley/src/rpi/backups/backup.log</string>

    <!-- ssh needs a PATH that includes the usual locations; launchd's default
         is minimal. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
